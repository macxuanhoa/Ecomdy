{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.local/schemas/routing.schema.json",
  "title": "DevHarness advisory routing registries",
  "oneOf": [
    {"$ref": "#/$defs/profile_registry"},
    {"$ref": "#/$defs/manifest_registry"},
    {"$ref": "#/$defs/recipe_registry"}
  ],
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "id_array": {
      "type": "array",
      "items": {"type": "string", "pattern": "^TECH-[0-9]{3}$"}
    },
    "agent_array": {
      "type": "array",
      "items": {"type": "string", "pattern": "^A[0-9]{2}$"}
    },
    "runtime_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_iterations", "max_runtime_minutes", "max_cost_usd", "enforcement"],
      "properties": {
        "max_iterations": {"type": "integer", "minimum": 1},
        "max_runtime_minutes": {"type": "integer", "minimum": 1},
        "max_cost_usd": {"type": "number", "minimum": 0},
        "enforcement": {"const": "advisory"}
      }
    },
    "retry_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retries"],
      "properties": {"max_retries": {"type": "integer", "minimum": 0}}
    },
    "context_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_files", "max_bytes", "include_originals", "enforcement"],
      "properties": {
        "max_files": {"type": "integer", "minimum": 1},
        "max_bytes": {"type": "integer", "minimum": 1},
        "include_originals": {"type": "boolean"},
        "enforcement": {"const": "advisory"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "implementation_status",
        "execution_status",
        "applicable_task_types",
        "activation_rules",
        "required_techniques",
        "optional_techniques",
        "disallowed_actions",
        "context_limits",
        "runtime_limits",
        "retry_limits",
        "verification_gates",
        "approval_conditions",
        "stop_conditions",
        "fallback",
        "max_parallel_agents"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^PROFILE-[A-Z]+$"},
        "name": {"enum": ["QUICK", "STANDARD", "DEEP", "PARALLEL", "AUTONOMOUS", "DEBUG", "DESIGN", "SECURITY", "AUDIT"]},
        "implementation_status": {"enum": ["advisory_design", "blocked_design", "implemented_verified"]},
        "execution_status": {"enum": ["NOT_IMPLEMENTED", "BLOCKED", "AVAILABLE", "VERIFIED"]},
        "applicable_task_types": {"$ref": "#/$defs/string_array"},
        "activation_rules": {"$ref": "#/$defs/string_array"},
        "required_techniques": {"$ref": "#/$defs/id_array"},
        "optional_techniques": {"$ref": "#/$defs/id_array"},
        "disallowed_actions": {"$ref": "#/$defs/string_array"},
        "context_limits": {"$ref": "#/$defs/context_limits"},
        "runtime_limits": {"$ref": "#/$defs/runtime_limits"},
        "retry_limits": {"$ref": "#/$defs/retry_limits"},
        "verification_gates": {"$ref": "#/$defs/string_array"},
        "approval_conditions": {"$ref": "#/$defs/string_array"},
        "stop_conditions": {"$ref": "#/$defs/string_array"},
        "fallback": {"type": "string", "minLength": 1},
        "max_parallel_agents": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "profile_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "registry_version", "status", "profiles"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "registry_version": {"type": "string", "minLength": 1},
        "status": {"const": "ADVISORY_DESIGN"},
        "profiles": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/profile"}}
      }
    },
    "activation_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "operator": {"enum": ["equals", "in", "lte", "gte"]},
        "value": {
          "oneOf": [
            {"type": "string"},
            {"type": "number"},
            {"type": "boolean"},
            {"type": "array", "items": {"type": ["string", "number", "boolean"]}}
          ]
        }
      }
    },
    "sequence_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "technique", "agent", "output"],
      "properties": {
        "step": {"type": "integer", "minimum": 1},
        "technique": {"type": "string", "pattern": "^TECH-[0-9]{3}$"},
        "agent": {"type": "string", "pattern": "^A[0-9]{2}$"},
        "output": {"type": "string", "minLength": 1}
      }
    },
    "context_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_paths", "exclude_paths", "max_files", "max_bytes", "include_originals"],
      "properties": {
        "include_paths": {"$ref": "#/$defs/string_array"},
        "exclude_paths": {"$ref": "#/$defs/string_array"},
        "max_files": {"type": "integer", "minimum": 1},
        "max_bytes": {"type": "integer", "minimum": 1},
        "include_originals": {"type": "boolean"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "task_types",
        "activation_rules",
        "profile",
        "required_techniques",
        "optional_techniques",
        "incompatible_techniques",
        "incompatible_tools",
        "sequence",
        "context_scope",
        "runtime_limits",
        "retry_limits",
        "verification_gates",
        "approval_conditions",
        "stop_conditions",
        "fallback",
        "rationale"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^ROUTE-[A-Z0-9-]+$"},
        "task_types": {"$ref": "#/$defs/string_array"},
        "activation_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/activation_rule"}},
        "profile": {"type": "string", "pattern": "^PROFILE-[A-Z]+$"},
        "required_techniques": {"$ref": "#/$defs/id_array"},
        "optional_techniques": {"$ref": "#/$defs/id_array"},
        "incompatible_techniques": {"$ref": "#/$defs/id_array"},
        "incompatible_tools": {"$ref": "#/$defs/string_array"},
        "sequence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sequence_step"}},
        "context_scope": {"$ref": "#/$defs/context_scope"},
        "runtime_limits": {"$ref": "#/$defs/runtime_limits"},
        "retry_limits": {"$ref": "#/$defs/retry_limits"},
        "verification_gates": {"$ref": "#/$defs/string_array"},
        "approval_conditions": {"$ref": "#/$defs/string_array"},
        "stop_conditions": {"$ref": "#/$defs/string_array"},
        "fallback": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "manifest_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "registry_version", "status", "manifests"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "registry_version": {"type": "string", "minLength": 1},
        "status": {"const": "ADVISORY_DESIGN"},
        "manifests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/manifest"}}
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "task_type",
        "route_id",
        "profile_id",
        "techniques",
        "inputs",
        "outputs",
        "acceptance_checks",
        "failure_handling",
        "owner_roles",
        "implementation_status"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^RECIPE-[0-9]{3}$"},
        "name": {"type": "string", "minLength": 1},
        "task_type": {"type": "string", "minLength": 1},
        "route_id": {"type": "string", "pattern": "^ROUTE-[A-Z0-9-]+$"},
        "profile_id": {"type": "string", "pattern": "^PROFILE-[A-Z]+$"},
        "techniques": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^TECH-[0-9]{3}$"}},
        "inputs": {"$ref": "#/$defs/string_array"},
        "outputs": {"$ref": "#/$defs/string_array"},
        "acceptance_checks": {"$ref": "#/$defs/string_array"},
        "failure_handling": {"type": "string", "minLength": 1},
        "owner_roles": {"$ref": "#/$defs/agent_array"},
        "implementation_status": {"const": "advisory_design"}
      }
    },
    "recipe_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "registry_version", "status", "recipes"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "registry_version": {"type": "string", "minLength": 1},
        "status": {"const": "ADVISORY_DESIGN"},
        "recipes": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/recipe"}}
      }
    }
  }
}
