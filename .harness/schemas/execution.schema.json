{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devharness.local/schemas/execution.schema.json",
  "title": "DevHarness execution trace and checkpoint",
  "oneOf": [
    {"$ref": "#/$defs/trace"},
    {"$ref": "#/$defs/checkpoint"}
  ],
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "head_commit", "base_commit", "changed_paths", "untracked_paths"],
      "properties": {
        "branch": {"type": ["string", "null"]},
        "head_commit": {"type": ["string", "null"]},
        "base_commit": {"type": ["string", "null"]},
        "changed_paths": {"$ref": "#/$defs/string_array"},
        "untracked_paths": {"$ref": "#/$defs/string_array"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "input_hashes", "excluded_paths", "limits", "enforcement"],
      "properties": {
        "manifest_path": {"type": ["string", "null"]},
        "input_hashes": {"$ref": "#/$defs/string_array"},
        "excluded_paths": {"$ref": "#/$defs/string_array"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_files", "max_bytes"],
          "properties": {
            "max_files": {"type": "integer", "minimum": 1},
            "max_bytes": {"type": "integer", "minimum": 1}
          }
        },
        "enforcement": {"const": "advisory"}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "status", "exit_code", "started_at", "finished_at", "output_excerpt", "output_truncated", "output_bytes", "evidence_path"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "cwd": {"type": "string", "minLength": 1},
        "status": {"enum": ["NOT_RUN", "PASS", "FAIL", "TIMEOUT", "BLOCKED"]},
        "exit_code": {"type": ["integer", "null"]},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "output_excerpt": {"type": "string"},
        "output_truncated": {"type": "boolean"},
        "output_bytes": {"type": ["integer", "null"], "minimum": 0},
        "evidence_path": {"type": ["string", "null"]}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "sequence", "technique_id", "agent_id", "status", "timestamps", "inputs", "outputs", "commands", "notes"],
      "properties": {
        "step_id": {"type": "string", "pattern": "^STEP-[0-9]{3}$"},
        "sequence": {"type": "integer", "minimum": 1},
        "technique_id": {"type": "string", "pattern": "^TECH-[0-9]{3}$"},
        "agent_id": {"type": ["string", "null"], "pattern": "^A[0-9]{2}$"},
        "status": {"enum": ["SELECTED", "ATTEMPTED", "EXECUTED", "VERIFIED", "SKIPPED", "BLOCKED", "FAILED"]},
        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected_at", "attempted_at", "executed_at", "verified_at"],
          "properties": {
            "selected_at": {"type": ["string", "null"], "format": "date-time"},
            "attempted_at": {"type": ["string", "null"], "format": "date-time"},
            "executed_at": {"type": ["string", "null"], "format": "date-time"},
            "verified_at": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "inputs": {"$ref": "#/$defs/string_array"},
        "outputs": {"$ref": "#/$defs/string_array"},
        "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
        "notes": {"type": "string"}
      }
    },
    "verification_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "status", "evidence"],
      "properties": {
        "criterion": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]},
        "evidence": {"$ref": "#/$defs/string_array"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "runtime_seconds", "retries", "token_usage", "cost_usd", "measurement_status"],
      "properties": {
        "iterations": {"type": "integer", "minimum": 0},
        "runtime_seconds": {"type": ["number", "null"], "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "token_usage": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["input", "output", "total"],
              "properties": {
                "input": {"type": ["integer", "null"], "minimum": 0},
                "output": {"type": ["integer", "null"], "minimum": 0},
                "total": {"type": ["integer", "null"], "minimum": 0}
              }
            }
          ]
        },
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "measurement_status": {"enum": ["unknown", "partial", "measured"]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["source", "test_result", "log", "report", "diagram", "other"]}
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "trace_id",
        "task_id",
        "status",
        "created_at",
        "updated_at",
        "route_id",
        "profile_id",
        "recipe_id",
        "repository",
        "context",
        "steps",
        "verification",
        "resources",
        "budgets",
        "approvals",
        "blockers",
        "artifacts",
        "limitations",
        "next_action"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "trace_id": {"type": "string", "pattern": "^TRACE-[0-9]{3}$"},
        "task_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["IN_PROGRESS", "COMPLETED", "BLOCKED", "FAILED", "ABORTED"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "route_id": {"type": "string", "pattern": "^ROUTE-[A-Z0-9-]+$"},
        "profile_id": {"type": "string", "pattern": "^PROFILE-[A-Z]+$"},
        "recipe_id": {"type": ["string", "null"], "pattern": "^RECIPE-[0-9]{3}$"},
        "repository": {"$ref": "#/$defs/repository"},
        "context": {"$ref": "#/$defs/context"},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acceptance_criteria", "results"],
          "properties": {
            "acceptance_criteria": {"$ref": "#/$defs/string_array"},
            "results": {"type": "array", "items": {"$ref": "#/$defs/verification_result"}}
          }
        },
        "resources": {"$ref": "#/$defs/resources"},
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_iterations", "max_runtime_minutes", "max_cost_usd", "max_retries", "enforcement"],
          "properties": {
            "max_iterations": {"type": "integer", "minimum": 1},
            "max_runtime_minutes": {"type": "integer", "minimum": 1},
            "max_cost_usd": {"type": "number", "minimum": 0},
            "max_retries": {"type": "integer", "minimum": 0},
            "enforcement": {"const": "advisory"}
          }
        },
        "approvals": {"$ref": "#/$defs/string_array"},
        "blockers": {"$ref": "#/$defs/string_array"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "limitations": {"$ref": "#/$defs/string_array"},
        "next_action": {"type": "string", "minLength": 1}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "checkpoint_id",
        "created_at",
        "task_id",
        "trace_id",
        "status",
        "route_id",
        "profile_id",
        "recipe_id",
        "repository",
        "completed_step_ids",
        "pending_step_ids",
        "blockers",
        "evidence_paths",
        "next_action",
        "resume_conditions"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "checkpoint_id": {"type": "string", "pattern": "^CHECKPOINT-[0-9]{3}$"},
        "created_at": {"type": "string", "format": "date-time"},
        "task_id": {"type": "string", "minLength": 1},
        "trace_id": {"type": "string", "pattern": "^TRACE-[0-9]{3}$"},
        "status": {"enum": ["READY_TO_RESUME", "BLOCKED", "COMPLETE"]},
        "route_id": {"type": "string", "pattern": "^ROUTE-[A-Z0-9-]+$"},
        "profile_id": {"type": "string", "pattern": "^PROFILE-[A-Z]+$"},
        "recipe_id": {"type": ["string", "null"], "pattern": "^RECIPE-[0-9]{3}$"},
        "repository": {"$ref": "#/$defs/repository"},
        "completed_step_ids": {"type": "array", "items": {"type": "string", "pattern": "^STEP-[0-9]{3}$"}},
        "pending_step_ids": {"type": "array", "items": {"type": "string", "pattern": "^STEP-[0-9]{3}$"}},
        "blockers": {"$ref": "#/$defs/string_array"},
        "evidence_paths": {"$ref": "#/$defs/string_array"},
        "next_action": {"type": "string", "minLength": 1},
        "resume_conditions": {"$ref": "#/$defs/string_array"}
      }
    }
  }
}
