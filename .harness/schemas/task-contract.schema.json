{
  "$schema": "https://json-schema.org/draft/2020-12",
  "$id": "https://devharness.local/schemas/task-contract.schema.json",
  "title": "DevHarness controlled verification task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "trace_id", "objective", "acceptance_criteria",
    "route_id", "profile_id", "recipe_id", "verification_technique_id",
    "scope", "commands", "budgets", "approvals"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "pattern": "^TRACE-[0-9]{3}$"},
    "objective": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "route_id": {"type": "string", "pattern": "^ROUTE-[A-Z0-9-]+$"},
    "profile_id": {"type": "string", "pattern": "^PROFILE-[A-Z]+$"},
    "recipe_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^RECIPE-[0-9]{3}$"}]},
    "verification_technique_id": {"type": "string", "pattern": "^TECH-[0-9]{3}$"},
    "scope": {"$ref": "#/$defs/scope"},
    "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}},
    "budgets": {"$ref": "#/$defs/budgets"},
    "approvals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_dir": {"type": "string", "minLength": 1, "default": ".harness/state/evidence"},
    "secret_scan_required": {"type": "boolean", "default": false}
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_paths", "max_changed_files", "max_changed_bytes"],
      "properties": {
        "allow_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "deny_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "base_commit": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"}]},
        "max_changed_files": {"type": "integer", "minimum": 1},
        "max_changed_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "argv", "criteria", "timeout_seconds", "max_output_bytes"],
      "properties": {
        "id": {"type": "string", "pattern": "^CHECK-[0-9]{3}$"},
        "kind": {"enum": ["test", "validation", "secret_scan"]},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 262144}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_iterations", "max_runtime_minutes", "max_cost_usd", "max_retries"],
      "properties": {
        "max_iterations": {"const": 1},
        "max_runtime_minutes": {"type": "integer", "minimum": 1},
        "max_cost_usd": {"const": 0},
        "max_retries": {"const": 0}
      }
    }
  }
}
