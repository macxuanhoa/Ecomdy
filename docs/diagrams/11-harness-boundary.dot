digraph G { graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.40", ranksep="0.55", labelloc=t, label="Development vs product boundary | TARGET DESIGN", fontname="DejaVu Sans", fontsize=20, fontcolor="#172B43"];
node [shape=box, style="rounded,filled", color="#718399", penwidth=1.1, fontname="DejaVu Sans", fontsize=11, fontcolor="#172B43", margin="0.18,0.12"]; edge [color="#60758A", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];
dev [label="DevHarness OS / development only", fillcolor="#E7EFFC"];
repo [label="Ecomdy source + specs + tests", fillcolor="#DFF1EB"];
ci [label="CI / review / release artifact", fillcolor="#FFF1D5"];
run [label="Ecomdy runtime / independent", fillcolor="#F0E8FA"];
owner [label="Marketing team", fillcolor="#F1F4F7"];
dev -> repo;
repo -> ci;
ci -> run [label="deploy approved release"];
run -> owner;
}